#include <iostream>
int main () {
    using namespace std;
    double Zap1 = 11.7;
    double Zap2 = 14.3;
    double Zap3 = 12.2;
    double Zap4 = 8.5;

    double Poch_prob = 67308.0;
    double Kin_prob = 68750.0;
    double V_ben = Zap1 + Zap2 + Zap3 + Zap4;
    double Vidstani = Kin_prob - Poch_prob;
    double Rozchid_1km = Poch_prob / Vidstani;

    cout << "Vsogo benzuny:" << " " << V_ben << " " << "l" << endl;
    cout << "Vidstani:" << " " << Vidstani << " " << "km" << endl;
    cout << "Rozhid benzuny:" << " " << Rozchid_1km << " " << "km/l" << endl;

    return 0;
}
